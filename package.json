    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-focus-lock": "^2.13.7",
    "react-transition-group": "^4.4.5",
    "stylus": "^0.64.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.322",
