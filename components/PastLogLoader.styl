.past-log-loader-button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: var(--radius);
  border: none;
  background: rgba(255, 255, 255, 0.1);
  color: var(--textcolor1);
  font-size: 13px;
  font-family: "Lato", "Yu Gothic UI", "Meiryo", sans-serif;
  line-height: 1;
  cursor: pointer;
  white-space: nowrap;
  transition: background 150ms ease, transform 150ms ease, box-shadow 150ms ease;

  &:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  &:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.5);
    outline-offset: 2px;
  }

  &:active {
    transform: scale(0.97);
  }

  svg {
    width: 18px;
    height: 18px;
  }
}
