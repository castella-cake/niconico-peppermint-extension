/* MintWatch (html.MW-Enabled) のシリーズストック追加ボタン統合用スタイル。
   .pm-series-stock-mount は watch.content.tsx が #pmw-seriesinfo .seriesinfo-content に
   autoMount する wrapper に付与されるクラス。
   色トークン (--accent1, --hover1, --border, --transition-normal 等) は MintWatch 側のものを参照する。
   ※ grid-template は Stylus が複数行値をパースできないため単行で記述する。 */

.watch-container[data-use-card-recommend="false"] .seriesinfo-content:has(.pm-series-stock-mount) {
  grid-template: "tmb tit ss fir" max-content "eps eps eps eps" 1fr / auto 1fr auto;
}

.seriesinfo-content:has(.pm-series-stock-mount) {
  grid-template: "tmb tit tit" max-content "eps eps eps" 1fr "ss ss fir" max-content / max-content 1fr;
}

.pm-series-stock-mount {
  grid-area: ss;
  align-self: center;
}

button.watch-action-button {
  border: var(--border);
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  padding: 6px 10px;
  background: var(--accent1);
  color: inherit;
  transition: var(--transition-normal);

  &:hover,
  &:active {
    background: var(--hover1);
  }
}